modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_DERIV_APP_ID = "33zvHyqn7EscMCXPTpyWX"
VITE_DERIV_APP_NAME = "legacy_trade_system"
VITE_DERIV_REFERRAL_LINK = "https://partner-tracking.deriv.com/click?a=25928&o=1&c=3&link_id=1"
VITE_DERIV_OAUTH_SCOPES = "trade,account_manage"
VITE_DERIV_ENV = "production"
VITE_FONT_FAMILY = "Inter"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20013
externalPort = 80

[[ports]]
localPort = 20014
externalPort = 3000
